# --- news-reader -------------------------------------------------------------
# One process per locale, ~300MB RSS each once warm.
#
# bin/run-locale.sh applies the resource limits (glibc arenas, V8 heap, libvips
# threads) and takes a per-locale flock, so a run that overruns its slot is not
# joined by the next tick - the next tick just exits. The app additionally caps
# how many locales may run at once (MAX_CONCURRENT_RUNS) and stops itself at
# MAX_RUN_SECONDS, leaving the remaining feeds to the next tick.
#
# Start minutes are staggered so the locales do not all pay the module load and
# feed fetch cost on the same second.
0-59/15  * * * * root /var/node/ournet/news-reader/bin/run-locale.sh ro-ro &> /var/log/news-reader-ro-ro.log
2-59/15  * * * * root /var/node/ournet/news-reader/bin/run-locale.sh ro-md &> /var/log/news-reader-ro-md.log
